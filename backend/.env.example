PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=employee_directory

# The admin who can sign in to the app. `npm run db:setup` creates this account;
# `npm run admin:reset` sets its password again from ADMIN_PASSWORD.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Optional: extra frontend origins allowed to call the API (comma-separated).
# Any http://localhost port is always allowed for development.
CORS_ORIGIN=
